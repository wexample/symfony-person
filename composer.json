{
  "name": "wexample/symfony-person",
  "description": "People as the public knows them: one entry per person, however many sources name them, found again by the identifiers those sources give them",
  "version": "2.0.0",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyPerson\\": "src/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=19.1.0",
    "symfony/string": "^7.4 || ^8.0",
    "wexample/symfony-media": ">=7.0.1"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}